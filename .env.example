# Backend
DATABASE_URL=postgresql://agent_tasks:agent_tasks@localhost:5432/agent_tasks
# docker-compose.prod.yml only: optional separate runtime role for the backend
# (no superuser, owns no table; see docs/grounding-migration.md, "Runtime
# database role"). Set both or neither; unset, the backend connects as the
# owner role. Use a URL-safe password, e.g. openssl rand -hex 32.
# POSTGRES_APP_USER=agent_tasks_app
# POSTGRES_APP_PASSWORD=
# Optional for GitHub connect/sync features:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required. Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Empty disables grounding only while every grounding history table is empty.
# One strict JSON object; public Ed25519 trust only. See docs/grounding-migration.md.
# Trust updates and revocation require coordinated restart of every writer.
GROUNDING_RUNTIME_CONFIG=
PORT=3001
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# Optional: GitHub webhook signature verification (required in production)
GITHUB_WEBHOOK_SECRET=
# Number of trusted reverse-proxy hops in front of the backend. Set to the
# count of proxies that append to X-Forwarded-For; the rate limiter reads the
# real client IP that many entries in from the right. The dev stack has no
# proxy, so keep 0: with a non-zero value a client can spoof its rate-limit
# bucket through X-Forwarded-For. Use 1 behind a single Traefik hop (the prod
# compose file defaults to 1).
TRUSTED_PROXY_HOPS=0
# Optional: retention window (days) for the webhook_deliveries /
# tool_invocations idempotency dedup tables before the periodic TTL sweep
# prunes rows older than it. Default (shown) comfortably exceeds GitHub's
# webhook redelivery window and any realistic MCP client retry window.
IDEMPOTENCY_TTL_DAYS=30
# Optional: enables the M4 "Suggest improvement" LLM rewrite helper
# (POST /tasks/:id/suggest-rewrite). Unset = the endpoint 503s for every
# project, regardless of the per-project aiHelpersEnabled flag. See
# docs/llm-rewrite-helper.md.
ANTHROPIC_API_KEY=
# Optional: overrides the model used by the rewrite helper above. Default
# (if unset) is claude-haiku-4-5.
AGENT_TASKS_REWRITE_MODEL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Production (docker-compose.prod.yml)
# Every line in this block is commented so copying this file to a dev .env
# changes nothing. Uncomment on the deploy host and replace the
# change-me placeholders; never commit real values. Generate secrets with:
#   openssl rand -hex 32
# Required by docker-compose.prod.yml (db, migrate and backend all
# interpolate ${POSTGRES_PASSWORD}; no default):
# POSTGRES_PASSWORD=change-me
# Public domain for the Traefik routers and the public URLs. The prod
# compose default is agent-tasks.opentriologue.ai:
# APP_DOMAIN=change-me
# Public backend origin used for SSO callback URLs (the schema default
# http://localhost:3001 is wrong in production):
# BACKEND_URL=https://change-me
# 32-byte key (hex or base64) encrypting OIDC client secrets at rest;
# required before any SSO connection can be created:
# SSO_ENCRYPTION_KEY=change-me
# Note: this template ships TRUSTED_PROXY_HOPS=0 for the proxy-free dev
# stack. Copying this file to a prod host overrides the prod compose
# default of 1 there, which breaks per-client rate limiting behind
# Traefik; delete the line or set it to 1 on the deploy host.
