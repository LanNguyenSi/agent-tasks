{
  "name": "@agent-tasks/backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push && prisma db execute --schema prisma/schema.prisma --file prisma/grounding-github-fence.sql && prisma db execute --schema prisma/schema.prisma --file prisma/clear-terminal-claims.sql",
    "db:seed": "tsx prisma/seed.ts",
    "shadow:report": "tsx src/scripts/shadow-report.ts",
    "audit:workflow-vocabulary": "tsx src/scripts/workflow-vocabulary-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@lannguyensi/evidence-ledger": "^0.5.1",
    "@lannguyensi/grounding-wrapper": "~0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^5.22.0",
    "hono": "^4.13.16",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "js-yaml": "^4.3.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
