{
  "version": 1,
  "repository": "LanNguyenSi/agent-tasks",
  "preflight": {
    "kind": "preflight",
    "name": "repository",
    "cwd": ".",
    "argv": [
      "preflight",
      "run",
      ".",
      "--json"
    ]
  },
  "extras": [
    {
      "kind": "check",
      "name": "build",
      "cwd": ".",
      "argv": [
        "agent-primitives",
        "verify",
        "-c",
        "build",
        "-x",
        "build=npm run build"
      ],
      "phase": "before_preflight"
    },
    {
      "kind": "check",
      "name": "test-types",
      "cwd": ".",
      "argv": [
        "agent-primitives",
        "verify",
        "-c",
        "typecheck_test",
        "-x",
        "typecheck_test=npm run typecheck:test"
      ],
      "phase": "before_preflight"
    },
    {
      "kind": "check",
      "name": "c08-focused",
      "cwd": ".",
      "argv": [
        "agent-primitives",
        "verify",
        "-c",
        "test,typecheck",
        "-x",
        "test=npm run test --workspace=backend -- tests/integration/grounding-context-writers.test.ts",
        "-x",
        "typecheck=npm run typecheck --workspace=backend"
      ],
      "phase": "before_preflight"
    },
    {
      "kind": "check",
      "name": "receipt-corpus",
      "cwd": ".",
      "argv": [
        "node",
        "scripts/grounding-receipt-contract.mjs",
        "check"
      ],
      "phase": "before_preflight"
    },
    {
      "kind": "check",
      "name": "okf",
      "cwd": ".",
      "argv": [
        "okf-kit",
        "check",
        "docs/okf"
      ],
      "phase": "before_preflight"
    }
  ]
}
