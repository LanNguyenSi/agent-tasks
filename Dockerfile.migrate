FROM node:22-slim
RUN apt-get update -y && apt-get install -y openssl
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN npm ci --workspace=backend --ignore-scripts
COPY backend/prisma backend/prisma
CMD ["sh", "-c", "npx prisma db push --schema=/app/backend/prisma/schema.prisma --skip-generate --accept-data-loss && npx prisma db execute --schema=/app/backend/prisma/schema.prisma --file=/app/backend/prisma/grounding-github-fence.sql"]
